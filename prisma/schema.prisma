generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  sslmode  = "verify-full"
}

datasource db {
  provider = "postgresql"
}

model SiteVisitor {
  id      Int @id @default(1)
  counter Int @default(0)
}

model BlogVisitor {
  slug    String @id
  counter Int    @default(0)
}
